{% comment %}
  Olympiad Problem Explorer

  Reads:
    _data/merged.yml

  Supports:
    IOQM, RMO and INMO

  Page-specific defaults:
    IOQM, RMO, INMO pages -> Competition
    Algebra, Combinatorics, Geometry, Number Theory pages -> Subject

  JavaScript handles filtering and rendering.
{% endcomment %}


{% comment %}
  1. Determine page-specific default filters
{% endcomment %}

{% assign default_competition = '' %}
{% assign default_subject = '' %}

{% case page.title %}
  {% when 'IOQM' %}
    {% assign default_competition = 'ioqm' %}

  {% when 'RMO' %}
    {% assign default_competition = 'rmo' %}

  {% when 'INMO' %}
    {% assign default_competition = 'inmo' %}

  {% when 'Algebra' %}
    {% assign default_subject = 'Algebra' %}

  {% when 'Combinatorics' %}
    {% assign default_subject = 'Combinatorics' %}

  {% when 'Geometry' %}
    {% assign default_subject = 'Geometry' %}

  {% when 'Number Theory' %}
    {% assign default_subject = 'Number Theory' %}
{% endcase %}


{% comment %}
  2. DEBUGGING PURPOSES ONLY

  Uncomment to inspect the raw JSON data.
{% endcomment %}

{% comment %}
<pre id="oe-debug" style="white-space: pre-wrap; font-size: 12px;">
{{ site.data.merged | jsonify | escape }}
</pre>
{% endcomment %}


{% comment %}
  3. Olympiad Problem Explorer
{% endcomment %}

{% comment %}
    For DEBUGGING PURPOSES ONLY: Uncomment the following <pre> block to see the raw JSON data being passed to the Olympiad Explorer component. This can help you understand the structure of the data and debug any issues with filtering or rendering.
    <pre id="oe-debug" style="white-space: pre-wrap; font-size: 12px;">
    {{ site.data.merged | jsonify | escape }}
    </pre>
{% endcomment %}

<div id="olympiad-explorer"
     class="olympiad-explorer"
     data-baseurl="{{ site.baseurl }}"
     data-olympiad='{{ site.data.merged | jsonify | escape }}'
     data-default-contest="{{ default_competition }}"
     data-default-subject="{{ default_subject }}">

  {% comment %}
    <div class="oe-header">
      <h2>Olympiad Problem Explorer</h2>
      <p>Explore problems by competition, year, subject and topic.</p>
    </div>
  {% endcomment %}

  <div class="oe-filters">

    <div class="oe-search">
      <input
        type="search"
        id="oe-search"
        placeholder="Search problems, subjects or topics..."
        aria-label="Search problems">
    </div>

    <div class="oe-filter-grid">

      <div class="oe-filter">
        <label for="oe-contest">Competition</label>
        <select id="oe-contest">
          <option value="">All competitions</option>
        </select>
      </div>

      <div class="oe-filter">
        <label for="oe-year">Year</label>
        <select id="oe-year">
          <option value="">All years</option>
        </select>
      </div>

      <div class="oe-filter">
        <label for="oe-subject">Subject</label>
        <select id="oe-subject">
          <option value="">All subjects</option>
        </select>
      </div>

      <div class="oe-filter">
        <label for="oe-topic">Topic</label>
        <select id="oe-topic">
          <option value="">All topics</option>
        </select>
      </div>

    </div>

    <div class="oe-filter-bottom">

      <label class="oe-checkbox">
        <input type="checkbox" id="oe-has-solutions">
        Only show papers with solutions
      </label>

      <button type="button" id="oe-reset" class="oe-reset">
        Reset filters
      </button>

    </div>

  </div>

  <div class="oe-results-header">
    <span id="oe-result-count">Loading problems...</span>
  </div>

  <div id="oe-results"
       class="oe-results"
       aria-live="polite">
  </div>

</div>


{% comment %}
  4. JavaScript
{% endcomment %}

<script src="{{ '/assets/js/topic-names.js' | relative_url }}" defer></script>
<script src="{{ '/assets/js/olympiad-explorer.js' | relative_url }}" defer></script>