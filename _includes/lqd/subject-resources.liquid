
<section class="subject-resources">

  <h2 class="subject-section-heading">
    <i class="fas fa-book-open"></i>
    Explore More Mathematics Resources
  </h2>

  {% if page.title == 'Algebra' or page.title == 'Combinatorics' or page.title == 'Geometry' or page.title == 'Number Theory' %}
    <h3>Explore Other Topics</h3>
  {% else %}
    <h3>Explore Various Topics</h3>
  {% endif %}

  {% assign subjects = "Algebra:alg:Algebra:stage-blue,Combinatorics:comb:Combinatorics:stage-teal,Geometry:geo:Geometry:stage-orange,Number Theory:nt:NumberTheory:stage-purple" | split: "," %}

  <div class="subject-resource-grid">

    {% for entry in subjects %}
      {% assign parts = entry | split: ":" %}
      {% assign name = parts[0] %}
      {% assign prefix = parts[1] %}
      {% assign slug = parts[1] %}
      {% assign folder = parts[2] %}
      {% assign colour = parts[3] %}

      {% if prefix != subject_slug %}

        <div class="subject-resource-card {{ colour }}">

            <a class="subject-resource-notes"
                href="{{ '/' | append: slug | append: '/' | relative_url }}"
                aria-label="View {{ name }} lecture notes">

                <strong>{{ name }}</strong>

            </a>

            <div class="subject-resource-actions">

                <a href="{{ '/' | append: slug | append: '/' | relative_url }}">
                Notes
                </a>

                <span>·</span>

                <a href="{{ '/assets/pdf/' | append: folder | append: '/' | append: prefix | append: '_yr.pdf' | relative_url }}">
                By Year
                </a>

                <span>·</span>

                <a href="{{ '/assets/pdf/' | append: folder | append: '/' | append: prefix | append: '_topic.pdf' | relative_url }}">
                By Topic
                </a>

            </div>

        </div>

      {% endif %}
    {% endfor %}

  </div>


  <h3>Further Lecture Notes and Resources</h3>

  {% assign other_resources = "INMO Training Camp:inmotc:stage-blue,IMO Training Camp:imotc:stage-teal,MOPSS:mopss:stage-orange,Simon Marais Mathematics Competition:smmc:stage-purple,Resources:resources:stage-blue" | split: "," %}

  <div class="subject-resource-grid subject-other-resources">

    {% for entry in other_resources %}
      {% assign parts = entry | split: ":" %}
      {% assign name = parts[0] %}
      {% assign slug = parts[1] %}
      {% assign colour = parts[2] %}

      <a class="subject-resource-card {{ colour }}"
         href="{{ '/' | append: slug | append: '/' | relative_url }}">

        <strong>{{ name }}</strong>
        <span>Explore resources <i class="fas fa-arrow-right"></i></span>

      </a>

    {% endfor %}

  </div>


</section>
