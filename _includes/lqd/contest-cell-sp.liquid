{% comment %}
  contest-cell-sp.liquid
  Used in: _layouts/page.liquid
  Effect in: rmo/yyyy/, inmo/yyyy/
{% endcomment %}
{% assign contest = include.contest %}
<table class="table table-bordered text-center align-middle">
  <thead>
    <tr>
      <th colspan="4" class="text-center bg-light">
        <strong>
          {{- page.ctst | upcase }}
          {{ page.yr -}}
        </strong>
      </th>
    </tr>
    <tr>
      <th>Question</th>
      <th>Solution</th>
      <th>Discussion</th>
      <th>AoPS</th>
    </tr>
  </thead>
  <tbody>
    {% for member in item[contest].qn %}
      <tr>
        <td>
          {% if member.qq %}
            <a href="{{ member.qq }}" target="_blank" rel="noopener noreferrer">
              <i class="fa-solid fa-file-pdf fa-2x"></i>
            </a>
          {% endif %}
        </td>
        <td>
          {% if member.sol %}
            <a href="{{ member.sol }}" target="_blank" rel="noopener noreferrer">
              <i class="fa-solid fa-file-pdf fa-2x"></i>
            </a>
          {% endif %}
        </td>
        <td>
          {% assign rmo_total = item[contest].qn.size %}
          {% assign rmo_index = forloop.index0 %}

          {% if contest == 'rmo' %}
            {% include lqd/contest-pdf-link.liquid contest=page.ctst year=page.yr total=rmo_total index=rmo_index %}
          {% endif %}          
          {% include lqd/manifest-discussion-links.liquid contest=contest year=page.yr variant=suffix %}
        </td>

        <td>
          {% for member in item[contest].aops %}
            {% if member.qq %}
              {{ member.src }}
              <a href="{{ member.qq }}" target="_blank" rel="noopener noreferrer">
                <i class="fa-solid fa-globe fa-2x"></i>
              </a>
            {% endif %}
          {% endfor %}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>
