{% comment %}
  contest-cell-sp.liquid
  Used in: _layouts/page.liquid
{% endcomment %}
{% assign contest = include.contest %}
<table class="table table-bordered text-center align-middle">
  <thead>
    <tr>
      <th colspan="4" class="text-center bg-light">
        <strong>
          {{- page.ctst | upcase }}
          {{ page.yr -}}
        </strong>
      </th>
    </tr>
    <tr>
      <th>Question</th>
      <th>Solution</th>
      <th>Discussion</th>
      <th>AoPS</th>
    </tr>
  </thead>
  <tbody>
    {% for member in item[contest].qn %}
      <tr>
        <td>
          {% if member.qq %}
            <a href="{{ member.qq }}" target="_blank" rel="noopener noreferrer">
              <i class="fa-solid fa-file-pdf fa-2x"></i>
            </a>
          {% endif %}
        </td>
        <td>
          {% if member.sol %}
            <a href="{{ member.sol }}" target="_blank" rel="noopener noreferrer">
              <i class="fa-solid fa-file-pdf fa-2x"></i>
            </a>
          {% endif %}
        </td>
        <td>
          {% if contest == 'rmo' %}
            {% assign suffix = '' %}
            {% if item[contest].qn.size != 1 %}
              {% assign letters = 'a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,v,w,x,y,z' | split: ',' %}
              {% assign suffix = letters[forloop.index0] %}
            {% endif %}
            <a
              href="{{ site.url }}{{ site.baseurl }}/assets/pdf/{{- page.ctst | upcase }}/{{- page.ctst | downcase }}{{ page.yr -}}{{ suffix }}.pdf"
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class="fa-regular fa-file-pdf fa-2x"></i>
            </a>
          {% endif %}
          {% if member.disc %}
            {% for ite in member.disc %}
              {%- capture mysuj -%}
                    {%- if ite.suj == 'a' -%}
                    Algebra
                    {%- elsif ite.suj == 'c' -%}
                    Combinatorics
                    {%- elsif ite.suj == 'g' -%}
                    Geometry
                    {%- elsif ite.suj == 'n' -%}
                    NumberTheory
                    {%- endif -%}
                    {%- endcapture -%}
              {% if ite.topic %}
                <a
                  href="{{ site.url }}{{ site.baseurl }}/assets/pdf/{{ mysuj }}/{{ ite.topic }}.pdf"
                  target="_blank"
                  rel="noopener noreferrer"
                  title="P{{ forloop.index }}"
                >
                  <i class="fa-regular fa-file-lines"></i>
                </a>
              {% endif %}
            {% endfor %}
          {% endif %}
        </td>
        <td>
          {% for member in item[contest].aops %}
            {% if member.qq %}
              {{ member.src }}
              <a href="{{ member.qq }}" target="_blank" rel="noopener noreferrer">
                <i class="fa-solid fa-globe fa-2x"></i>
              </a>
            {% endif %}
          {% endfor %}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>
