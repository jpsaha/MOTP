
{% assign contest = include.contest %}
{% assign year = include.year %}
{% assign suffix = '' %}

{% if include.total != 1 %}
  {% assign letters = 'a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,v,w,x,y,z' | split: ',' %}
  {% assign suffix = letters[include.index] %}
{% endif %}

<a
  href="{{ site.url }}{{ site.baseurl }}/assets/pdf/{{ contest | upcase }}/{{ contest | downcase }}{{ year }}{{ suffix }}.pdf"
  target="_blank"
  rel="noopener noreferrer"
>
  <i class="fa-regular fa-file-pdf fa-2x"></i>
</a>
